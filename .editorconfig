root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = tab
indent_size = 4

[justfile]
indent_style = space
indent_size = 4

[{{.,}*.{js{,on},y{a,}ml,sh,md,txt}}]
indent_style = space
indent_size = 2

[*.{md,txt}]
trim_trailing_whitespace = true
